        "@clerk/backend": "^3.11.5",
        "@hono/zod-validator": "^0.8.0",
        "@nightcode/database": "workspace:*",
        "@nightcode/shared": "workspace:*",
        "@sentry/bun": "^10.57.0",
        "@sentry/hono": "^10.57.0",
        "ai": "^7.0.0",
        "dotenv": "^17.4.2",
        "hono": "^4.12.23",
        "zod": "^4.4.3"
    }
}